# Copie para o ambiente (export/set) antes de rodar `python app.py`.

# Chave de sessão do Flask. Se vazia, uma chave aleatória é gerada a cada boot.
SECRET_KEY=
# Debug do Flask/Werkzeug. NUNCA habilite com HOST=0.0.0.0 em ambiente acessível.
FLASK_DEBUG=false
APP_ENV=development
HOST=0.0.0.0
PORT=5000
DATABASE_PATH=loja.db
# Origens permitidas no CORS, separadas por vírgula (ex.: http://localhost:3000)
CORS_ORIGINS=*
# Token exigido no header X-Admin-Token para /admin/*. Vazio = rotas admin bloqueadas (403).
ADMIN_TOKEN=
# Habilita /admin/query (SQL livre). Requer também ADMIN_TOKEN.
ENABLE_ADMIN_QUERY=false
LOG_LEVEL=INFO
