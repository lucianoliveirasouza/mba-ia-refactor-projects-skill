# Copie para .env e ajuste. Nunca commite valores reais.
PORT=3000
# ':memory:' (padrão) ou caminho de arquivo SQLite
DB_PATH=:memory:
# Chave do gateway de pagamento (nunca é logada)
PAYMENT_GATEWAY_KEY=
# Token exigido no header X-Admin-Token para /api/admin/* e DELETE /api/users/:id.
# Vazio = rotas administrativas bloqueadas.
ADMIN_TOKEN=
# debug | info | warn | error | silent
LOG_LEVEL=info
