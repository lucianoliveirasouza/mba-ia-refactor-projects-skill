# Copie para .env e ajuste os valores. Nunca commite o .env real.

# Chave usada para assinar tokens de autenticação (obrigatória em produção)
SECRET_KEY=change-me

# URI do banco (SQLAlchemy). Caminho relativo do SQLite fica em instance/
DATABASE_URL=sqlite:///tasks.db

# Servidor
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=false
LOG_LEVEL=INFO

# Origens permitidas pelo CORS (separadas por vírgula; use * só em desenvolvimento)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Validade do token de login, em segundos
TOKEN_MAX_AGE_SECONDS=86400

# SMTP para notificações (vazio = envio desabilitado, apenas log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
